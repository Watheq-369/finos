OPENROUTER_API_KEY=
MODEL_CLASSIFY=openai/gpt-4o-mini
MODEL_EXTRACT=openai/gpt-4o-mini
OWN_DOMAIN=younesmotasam.com
OWNER_NAME=Younes

# Review queue (Lovable Cloud). Shipped in Slice 2, required by `run --push`.
INGEST_URL=
INGEST_SECRET=

# Slack source (Slice C). Read-only scopes. Only a TAGGED message is ever picked up.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
SLACK_PICKUP_TAG=invoice

# Stripe, the billing system of record (Slice B/C). RESTRICTED key, test mode, invoicing
# scope only. Lives in the worker only, never in the browser. Never a root key.
STRIPE_RESTRICTED_KEY=

# Output seam: the worker reads approved rows and reports sends back (Slice B).
SEND_SECRET=
